
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: 'Poppins', sans-serif; background:#f8f9fa; margin:0; padding:0; }
        .container { max-width:600px; margin:0 auto; background:#fff; border-radius:16px; overflow:hidden; }
        .header { background:linear-gradient(135deg,#c0392b,#e74c3c); padding:30px; text-align:center; }
        .header h1 { color:#fff; margin:0; font-size:24px; }
        .content { padding:30px; }
        .info-box { background:#f8f9fa; border-radius:8px; padding:15px; margin:10px 0; }
        .badge { display:inline-block; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600; }
        .facile { background:#e8f5e9; color:#2e7d32; }
        .moyen { background:#fff8e1; color:#f57f17; }
        .difficile { background:#ffebee; color:#c62828; }
        .footer { background:#2c3e50; color:rgba(255,255,255,0.6); text-align:center; padding:20px; font-size:12px; }
        .btn { display:inline-block; background:#e74c3c; color:#fff; padding:12px 30px; border-radius:25px; text-decoration:none; font-weight:600; margin-top:20px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🍽️ RecipeHub</h1>
            <p style="color:rgba(255,255,255,0.8);margin:5px 0 0;">Nouvelle recette publiée !</p>
        </div>

        <div class="content">
            <h2 style="color:#2c3e50;">{{ recette.titre }}</h2>

            <div class="info-box">
                <p><strong>👨‍🍳 Auteur :</strong> {{ recette.auteur ? recette.auteur.pseudo : 'Anonyme' }}</p>
                <p><strong>📂 Catégorie :</strong> {{ recette.categorie ? recette.categorie.nom : 'Non définie' }}</p>
                <p>
                    <strong>🎯 Difficulté :</strong>
                    <span class="badge {{ recette.difficulte }}">
                        {% if recette.difficulte == 'facile' %}🟢{% elseif recette.difficulte == 'moyen' %}🟡{% else %}🔴{% endif %}
                        {{ recette.difficulte|capitalize }}
                    </span>
                </p>
                <p><strong>⏱️ Temps de préparation :</strong> {{ recette.tempsPreparation }} min</p>
                {% if recette.tempsCuisson %}
                    <p><strong>🔥 Temps de cuisson :</strong> {{ recette.tempsCuisson }} min</p>
                {% endif %}
                <p><strong>👥 Personnes :</strong> {{ recette.nbPersonnes }}</p>
            </div>

            <p style="color:#555;">{{ recette.description }}</p>

            <div style="text-align:center;">
                <a href="{{ path('recette_detail', {id: recette.id}) }}" class="btn">
                    Voir la recette complète
                </a>
            </div>
        </div>

        <div class="footer">
            <p>© 2025 RecipeHub — Vous recevez cet email car une nouvelle recette a été publiée.</p>
        </div>
    </div>
</body>
</html>