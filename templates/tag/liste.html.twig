{% extends 'base.html.twig' %}
{% block title %}Tags — RecipeHub{% endblock %}

{% block body %}


<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="section-title">Tous les tags</h2>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('tag_nouveau') }}" class="btn-voir">
                <i class="fas fa-plus me-2"></i>Nouveau tag
            </a>
        {% endif %}
    </div>

    <div class="row g-4">
        {% for tag in tags %}
        <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6">
            <div class="recipe-card h-100 text-center p-4">
                <div class="mb-3">
                    <span class="badge rounded-pill px-4 py-3 fs-5"
                          style="background-color:{{ tag.couleur }};color:#fff;">
                        {{ tag.nom }}
                    </span>
                </div>

                <div class="mb-3">
                    <div style="width:40px;height:6px;border-radius:3px;background:{{ tag.couleur }};margin:0 auto;"></div>
                </div>

                <p class="text-muted small mb-3">
                    <i class="fas fa-palette me-1"></i>{{ tag.couleur }}
                </p>

                {% if is_granted('ROLE_ADMIN') %}
                <form method="post"
                      action="{{ path('tag_supprimer', {id: tag.id}) }}"
                      style="display:inline;">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('supprimer' ~ tag.id) }}">
                    <button type="button" class="btn-suppr w-100" data-confirm-delete="Êtes-vous sûr de vouloir supprimer ce tag ?">
                        <i class="fas fa-trash me-2"></i>Supprimer
                    </button>
                </form>
                {% endif %}
            </div>
        </div>
        {% else %}
        <div class="col-12">
            <div class="text-center py-5">
                <div style="font-size:80px">🏷️</div>
                <h4 class="mt-3 text-muted">Aucun tag pour le moment</h4>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('tag_nouveau') }}" class="btn-voir mt-3 d-inline-block">
                        <i class="fas fa-plus me-2"></i>Créer un tag
                    </a>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
</div>

{% endblock %}