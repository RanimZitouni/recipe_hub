{% extends 'base.html.twig' %}
{% block title %}Nouveau tag{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header"><h4>Nouveau tag</h4></div>
            <div class="card-body">
                {{ form_start(form) }}
                    {{ form_row(form.nom) }}
                    {{ form_row(form.couleur) }}
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success">Créer</button>
                        <a href="{{ path('tag_liste') }}" class="btn btn-secondary">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}