{% extends 'base.html.twig' %}
{% block title %}Nouvel ingrédient{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header"><h4>Ajouter un ingrédient à {{ recette.titre }}</h4></div>
            <div class="card-body">
                {{ form_start(form) }}
                    {{ form_row(form.nom) }}
                    {{ form_row(form.quantite) }}
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success">Ajouter</button>
                        <a href="{{ path('recette_detail', {id: recette.id}) }}" class="btn btn-secondary">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}