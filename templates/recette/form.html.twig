{% extends 'base.html.twig' %}
{% block title %}{{ titre }} — RecipeHub{% endblock %}

{% block body %}
<div class="page-header">
    <div class="container">
        <a href="{{ path('recette_liste') }}" style="color:rgba(255,255,255,0.7);text-decoration:none;">
            <i class="fas fa-arrow-left me-2"></i>Retour
        </a>
        <h1 class="mt-2">{{ titre }}</h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-card">
                {% if form.vars.errors|length > 0 %}
                    <div class="alert alert-danger">
                        <strong>Erreurs de formulaire:</strong>
                        {% for error in form.vars.errors %}
                            <div>{{ error.message }}</div>
                        {% endfor %}
                    </div>
                {% endif %}
                
                {{ form_start(form, {'attr': {'class': 'needs-validation'}, 'multipart': true}) }}
                <div class="row g-3">
                    <div class="col-12">{{ form_row(form.titre) }}</div>
                    <div class="col-12">{{ form_row(form.description) }}</div>
                    <div class="col-12">{{ form_row(form.instructions) }}</div>
                    <div class="col-md-4">{{ form_row(form.tempsPreparation) }}</div>
                    <div class="col-md-4">{{ form_row(form.tempsCuisson) }}</div>
                    <div class="col-md-4">{{ form_row(form.nbPersonnes) }}</div>
                    <div class="col-md-6">{{ form_row(form.difficulte) }}</div>
                    <div class="col-md-6">{{ form_row(form.categorie) }}</div>
                    <div class="col-12">{{ form_row(form.tags) }}</div>
                    <div class="col-12">{{ form_row(form.imageFile) }}</div>
                    <div class="col-12">{{ form_row(form.publiee) }}</div>
                </div>
                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn-voir" style="padding:10px 30px;font-size:15px;">
                        <i class="fas fa-save me-2"></i>Enregistrer
                    </button>
                    <a href="{{ path('recette_liste') }}" class="btn-suppr" style="padding:10px 20px;font-size:15px;text-decoration:none;">
                        Annuler
                    </a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}