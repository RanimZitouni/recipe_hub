{% extends 'base.html.twig' %}
{% block title %}Mes favoris — RecipeHub{% endblock %}

{% block body %}

<div class="page-header">
    <div class="container">
        <a href="{{ path('recette_liste') }}" style="color:rgba(255,255,255,0.7);text-decoration:none;">
            <i class="fas fa-arrow-left me-2"></i>Retour aux recettes
        </a>
        <h1 class="mt-2">⭐ Mes recettes favorites</h1>
    </div>
</div>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="section-title">Recettes favorites</h2>
        <span class="text-muted">{{ recettes|length }} recette(s)</span>
    </div>

    <div class="row g-4">
        {% for recette in recettes %}
        <div class="col-xl-4 col-lg-4 col-md-6">
            <div class="recipe-card h-100">
                {% if recette.imageName %}
                    <img src="{{ asset('uploads/images/' ~ recette.imageName) }}"
                         class="card-img-top" alt="{{ recette.titre }}">
                {% else %}
                    <div class="card-img-placeholder">🍽️</div>
                {% endif %}

                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="fw-bold mb-0" style="color:#2c3e50">{{ recette.titre }}</h5>
                        {% if recette.difficulte == 'facile' %}
                            <span class="badge-facile">🟢 Facile</span>
                        {% elseif recette.difficulte == 'moyen' %}
                            <span class="badge-moyen">🟡 Moyen</span>
                        {% else %}
                            <span class="badge-difficile">🔴 Difficile</span>
                        {% endif %}
                    </div>

                    {% if recette.categorie %}
                        <p class="card-meta mb-1">
                            {{ recette.categorie.icone }} {{ recette.categorie.nom }}
                        </p>
                    {% endif %}

                    <p class="card-meta mb-2">
                        ⏱️ {{ recette.tempsPreparation + (recette.tempsCuisson ?? 0) }} min
                        &nbsp;|&nbsp; 👥 {{ recette.nbPersonnes }} pers.
                    </p>

                    <div class="mb-3">
                        {% for tag in recette.tags %}
                            <span class="badge rounded-pill me-1"
                                  style="background-color:{{ tag.couleur }};font-size:11px;">
                                {{ tag.nom }}
                            </span>
                        {% endfor %}
                    </div>

                    <div class="d-flex gap-2">
                        <a href="{{ path('recette_detail', {id: recette.id}) }}" class="btn-voir">
                            <i class="fas fa-eye me-1"></i>Voir
                        </a>
                        <form method="post" action="{{ path('app_favori_remove', {id: recette.id}) }}"
                              style="display:inline;">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('remove_favori' ~ recette.id) }}">
                            <button class="btn-suppr" title="Retirer des favoris">
                                <i class="fas fa-times"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center py-5">
            <div style="font-size:80px">⭐</div>
            <h4 class="mt-3 text-muted">Aucune recette favorite</h4>
            <p class="text-muted mb-4">Ajoutez des recettes à vos favoris depuis leur page de détail</p>
            <a href="{{ path('recette_liste') }}" class="btn-hero">
                Découvrir les recettes
            </a>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}