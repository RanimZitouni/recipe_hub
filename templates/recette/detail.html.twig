{% extends 'base.html.twig' %}
{% block title %}{{ recette.titre }} — RecipeHub{% endblock %}

{% block body %}
<div class="page-header">
    <div class="container">
        <a href="{{ path('recette_liste') }}" style="color:rgba(255,255,255,0.7);text-decoration:none;">
            <i class="fas fa-arrow-left me-2"></i>Retour aux recettes
        </a>
        <h1 class="mt-2">{{ recette.titre }}</h1>
        <div class="d-flex align-items-center gap-3 mt-2">
            <span class="badge bg-light text-dark">{{ difficulty_stars(recette.difficulte) }}</span>
            {% if recette.categorie %}
                <span style="color:rgba(255,255,255,0.8)">{{ recette.categorie.icone }} {{ recette.categorie.nom }}</span>
            {% endif %}
            <span style="color:rgba(255,255,255,0.8)">📅 {{ recette.dateCreation|time_ago }}</span>
            {% if app.user %}
                {% if isFavori %}
                    <form method="post" action="{{ path('app_favori_remove', {id: recette.id}) }}" style="display:inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('remove_favori' ~ recette.id) }}">
                        <button type="submit" class="btn btn-warning btn-sm" style="color: white; background-color: #ffc107; border-color: #ffc107;">
                            <i class="fas fa-star"></i> Retirer des favoris
                        </button>
                    </form>
                {% else %}
                    <form method="post" action="{{ path('app_favori_add', {id: recette.id}) }}" style="display:inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('add_favori' ~ recette.id) }}">
                        <button type="submit" class="btn btn-warning btn-sm" style="color: white; background-color: #ffc107; border-color: #ffc107;">
                            ⭐ Ajouter aux favoris
                        </button>
                    </form>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>

<div class="container pb-5">
    {% if recette.imageName %}
    <img src="{{ asset('uploads/recettes/' ~ recette.imageName) }}"
         class="img-fluid rounded-4 w-100 mb-4"
         style="max-height:450px;object-fit:cover;"
         alt="{{ recette.titre }}">
{% endif %}

    <div class="row mb-4">
        <div class="col-auto">
            <div class="form-card text-center px-4">
                <div style="font-size:24px">⏱️</div>
                <div class="fw-bold">{{ recette.tempsPreparation|cooking_time_format }}</div>
                <div class="text-muted small">Préparation</div>
            </div>
        </div>
        {% if recette.tempsCuisson %}
        <div class="col-auto">
            <div class="form-card text-center px-4">
                <div style="font-size:24px">🔥</div>
                <div class="fw-bold">{{ recette.tempsCuisson|cooking_time_format }}</div>
                <div class="text-muted small">Cuisson</div>
            </div>
        </div>
        {% endif %}
        <div class="col-auto">
            <div class="form-card text-center px-4">
                <div style="font-size:24px">👥</div>
                <div class="fw-bold">{{ recette.nbPersonnes }}</div>
                <div class="text-muted small">Personnes</div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        {% for tag in recette.tags %}
            <span class="badge rounded-pill me-1"
                  style="background-color:{{ tag.couleur }};font-size:13px;padding:6px 14px;">
                {{ tag.nom }}
            </span>
        {% endfor %}
    </div>

    <p class="lead mb-4">{{ recette.description }}</p>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="form-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="section-title mb-0">🧂 Ingrédients</h4>
                    {% if app.user and (is_granted('ROLE_ADMIN') or (recette.auteur and recette.auteur.id == app.user.id)) %}
                        <a href="{{ path('ingredient_nouveau', {id: recette.id}) }}"
                           class="btn-voir" style="font-size:12px;">+ Ajouter</a>
                    {% endif %}
                </div>
                <ul class="list-unstyled">
                    {% for ingredient in recette.ingredients %}
                    <li class="d-flex justify-content-between align-items-center py-2"
                        style="border-bottom:1px solid #f0f0f0;">
                        <span>
                            <i class="fas fa-check-circle text-success me-2"></i>
                            {{ ingredient.nom }}
                        </span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-dark">{{ ingredient.quantite }}</span>
                            {% if app.user and (is_granted('ROLE_ADMIN') or (recette.auteur and recette.auteur.id == app.user.id)) %}
                                <form method="post" action="{{ path('ingredient_supprimer', {id: ingredient.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('supprimer' ~ ingredient.id) }}">
                                    <button type="button" class="btn-suppr" style="padding:2px 8px;font-size:11px;" data-confirm-delete="Supprimer cet ingrédient ?">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </li>
                    {% else %}
                    <li class="text-muted text-center py-3">Aucun ingrédient</li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <div class="col-md-8">
            <div class="form-card h-100">
                <h4 class="section-title mb-4">📋 Instructions</h4>
                <p style="white-space:pre-line;line-height:1.8;color:#555;">
                    {{ recette.instructions }}
                </p>
            </div>
        </div>
    </div>

    {% if app.user and (is_granted('ROLE_ADMIN') or (recette.auteur and recette.auteur.id == app.user.id)) %}
        <div class="d-flex gap-3 mt-4">
            <a href="{{ path('recette_modifier', {id: recette.id}) }}" class="btn-modifier">
                <i class="fas fa-edit me-2"></i>Modifier la recette
            </a>
            <form method="post" action="{{ path('recette_supprimer', {id: recette.id}) }}" style="display:inline;">
                <input type="hidden" name="_token"
                       value="{{ csrf_token('supprimer' ~ recette.id) }}">
                <button type="button" class="btn-suppr" style="padding:10px 20px;font-size:15px;" data-confirm-delete="Êtes-vous sûr de vouloir supprimer cette recette ?">
                    <i class="fas fa-trash me-2"></i>Supprimer
                </button>
            </form>
        </div>
    {% endif %}
</div>
{% endblock %}