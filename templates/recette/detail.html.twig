{% extends 'base.html.twig' %}
{% block title %}{{ recette.titre }}{% endblock %}

{% block body %}
<div class="mb-3">
    <a href="{{ path('recette_liste') }}" class="btn btn-outline-secondary">← Retour</a>
    <a href="{{ path('recette_modifier', {id: recette.id}) }}" class="btn btn-warning ms-2">Modifier</a>
</div>

{% if recette.imageName %}
    <img src="{{ asset('uploads/images/' ~ recette.imageName) }}" class="img-fluid rounded mb-4 w-100" style="max-height:400px;object-fit:cover;" alt="{{ recette.titre }}">
{% endif %}

<div class="d-flex align-items-center gap-3 mb-3">
    <h1>{{ recette.titre }}</h1>
    {% if recette.difficulte == 'facile' %}
        <span class="badge bg-success fs-6">🟢 Facile</span>
    {% elseif recette.difficulte == 'moyen' %}
        <span class="badge bg-warning text-dark fs-6">🟡 Moyen</span>
    {% else %}
        <span class="badge bg-danger fs-6">🔴 Difficile</span>
    {% endif %}
</div>

<p class="text-muted">
    ⏱️ Préparation : {{ recette.tempsPreparation }} min
    {% if recette.tempsCuisson %} | 🔥 Cuisson : {{ recette.tempsCuisson }} min{% endif %}
    | 👥 {{ recette.nbPersonnes }} personnes
    {% if recette.categorie %} | {{ recette.categorie.icone }} {{ recette.categorie.nom }}{% endif %}
</p>

<div class="mb-3">
    {% for tag in recette.tags %}
        <span class="badge" style="background-color: {{ tag.couleur }}">{{ tag.nom }}</span>
    {% endfor %}
</div>

<p>{{ recette.description }}</p>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <strong>🧂 Ingrédients</strong>
                <a href="{{ path('ingredient_nouveau', {id: recette.id}) }}" class="btn btn-sm btn-outline-success">+ Ajouter</a>
            </div>
            <ul class="list-group list-group-flush">
                {% for ingredient in recette.ingredients %}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>{{ ingredient.nom }} — <em>{{ ingredient.quantite }}</em></span>
                    <form method="post" action="{{ path('ingredient_supprimer', {id: ingredient.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ ingredient.id) }}">
                        <button class="btn btn-danger btn-sm">🗑️</button>
                    </form>
                </li>
                {% else %}
                <li class="list-group-item text-muted">Aucun ingrédient</li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header"><strong>📋 Instructions</strong></div>
            <div class="card-body">
                <p style="white-space: pre-line">{{ recette.instructions }}</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}