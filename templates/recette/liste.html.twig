{% extends 'base.html.twig' %}
{% block title %}Recettes — RecipeHub{% endblock %}

{% block body %}

<div class="hero-fullscreen">
    <div class="hero-overlay">
        <div class="hero-content text-center">
            <h1>Découvrez nos Recettes</h1>
            <p>Des recettes délicieuses pour tous les goûts</p>
            <a href="{{ path('recette_nouvelle') }}" class="btn-hero">+ Nouvelle recette</a>
            <div class="scroll-down mt-4">
                <i class="fas fa-chevron-down fa-2x" style="color:rgba(255,255,255,0.7);animation:bounce 2s infinite;"></i>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    {# ===== STATS ===== #}
    <div class="row g-3 mb-5">
        <div class="col-md-3 col-6">
            <div class="recipe-card text-center p-4">
                <div style="font-size:36px">📢</div>
                <h3 class="fw-bold mt-2" style="color:#e74c3c;">{{ totalPubliees }}</h3>
                <p class="text-muted mb-0 small">Recettes publiées</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="recipe-card text-center p-4">
                <div style="font-size:36px">🍽️</div>
                <h3 class="fw-bold mt-2" style="color:#e74c3c;">{{ recettes|length }}</h3>
                <p class="text-muted mb-0 small">Total recettes</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="recipe-card text-center p-4">
                <div style="font-size:36px">🧂</div>
                <h3 class="fw-bold mt-2" style="color:#e74c3c;">{{ moyenneIngredients }}</h3>
                <p class="text-muted mb-0 small">Moy. ingrédients</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="recipe-card text-center p-4">
                <div style="font-size:36px">📂</div>
                <h3 class="fw-bold mt-2" style="color:#e74c3c;">{{ recettesParCategorie|length }}</h3>
                <p class="text-muted mb-0 small">Catégories</p>
            </div>
        </div>
    </div>

    {# ===== RECETTES PAR CATEGORIE ===== #}
    {% if recettesParCategorie %}
    <div class="form-card mb-5">
        <h5 class="fw-bold mb-3" style="color:#e74c3c;">
            <i class="fas fa-chart-bar me-2"></i>Recettes par catégorie
        </h5>
        <div class="d-flex flex-wrap gap-2">
            {% for categorie, nombre in recettesParCategorie %}
                <span class="badge rounded-pill px-3 py-2"
                      style="background:#fff0ee;color:#e74c3c;font-size:13px;">
                    📂 {{ categorie }} — {{ nombre }} recette(s)
                </span>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ===== FILTRE RECETTES ===== #}
    <div class="form-card mb-4">
        <h5 class="fw-bold mb-3" style="color:#e74c3c;">
            <i class="fas fa-filter me-2"></i>Filtrer les recettes
        </h5>
        {{ form_start(filterForm, {'method':'GET', 'attr': {'class':'row g-3 align-items-end'}}) }}
            <div class="col-md-3">
                <small class="text-muted d-block mb-1">Titre</small>
                {{ form_widget(filterForm.titre, {'attr': {'class':'form-control', 'placeholder':'Titre...'}}) }}
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block mb-1">Catégorie</small>
                {{ form_widget(filterForm.categorie, {'attr': {'class':'form-select'}}) }}
            </div>
            <div class="col-md-2">
                <small class="text-muted d-block mb-1">Difficulté</small>
                {{ form_widget(filterForm.difficulte, {'attr': {'class':'form-select'}}) }}
            </div>
            <div class="col-md-2">
                <small class="text-muted d-block mb-1">Tag</small>
                {{ form_widget(filterForm.tag, {'attr': {'class':'form-select'}}) }}
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-primary w-100">Rechercher</button>
            </div>
            <div class="col-12">
                <a href="{{ path('recette_liste') }}" class="btn btn-link btn-sm">Réinitialiser les filtres</a>
            </div>
        {{ form_end(filterForm) }}
    </div>

    {# ===== LISTE RECETTES ===== #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="section-title">Toutes les recettes</h2>
        <span class="text-muted">{{ recettes|length }} recette(s)</span>
    </div>

    <div class="row g-4">
        {% for recette in recettes %}
        <div class="col-xl-4 col-lg-4 col-md-6">
            <div class="recipe-card h-100">
                {% if recette.imageName %}
    <img src="{{ asset('uploads/recettes/' ~ recette.imageName) }}"
         class="card-img-top" alt="{{ recette.titre }}">
{% else %}
    <div class="card-img-placeholder">
        {% if recette.categorie and recette.categorie.icone %}
            {{ recette.categorie.icone }}
        {% else %}
            🍽️
        {% endif %}
    </div>
{% endif %}

                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="fw-bold mb-0" style="color:#2c3e50">{{ recette.titre }}</h5>
                        {% if recette.difficulte == 'facile' %}
                            <span class="badge-facile">🟢 Facile</span>
                        {% elseif recette.difficulte == 'moyen' %}
                            <span class="badge-moyen">🟡 Moyen</span>
                        {% else %}
                            <span class="badge-difficile">🔴 Difficile</span>
                        {% endif %}
                    </div>

                    {% if recette.categorie %}
                        <p class="card-meta mb-1">
                            {{ recette.categorie.icone }} {{ recette.categorie.nom }}
                        </p>
                    {% endif %}

                    <p class="card-meta mb-2">
                        ⏱️ {{ recette.tempsPreparation + (recette.tempsCuisson ?? 0) }} min
                        &nbsp;|&nbsp; 👥 {{ recette.nbPersonnes }} pers.
                    </p>

                    <div class="mb-3">
                        {% for tag in recette.tags %}
                            <span class="badge rounded-pill me-1"
                                  style="background-color:{{ tag.couleur }};font-size:11px;">
                                {{ tag.nom }}
                            </span>
                        {% endfor %}
                    </div>

                    <div class="d-flex gap-2">
                        <a href="{{ path('recette_detail', {id: recette.id}) }}" class="btn-voir">
                            <i class="fas fa-eye me-1"></i>Voir
                        </a>
                        {% if app.user and (is_granted('ROLE_ADMIN') or (recette.auteur and recette.auteur.id == app.user.id)) %}
                            <a href="{{ path('recette_modifier', {id: recette.id}) }}" class="btn-modifier">
                                <i class="fas fa-edit me-1"></i>Modifier
                            </a>
                            <form method="post" action="{{ path('recette_supprimer', {id: recette.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('supprimer' ~ recette.id) }}">
                                <button type="button" class="btn-suppr" data-confirm-delete="Êtes-vous sûr de vouloir supprimer cette recette ?"><i class="fas fa-trash"></i></button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center py-5">
            <div style="font-size:80px">🍽️</div>
            <h4 class="mt-3 text-muted">Aucune recette</h4>
            <a href="{{ path('recette_nouvelle') }}" class="btn-hero mt-3 d-inline-block">
                Créer ma première recette
            </a>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}