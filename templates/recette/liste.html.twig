{% extends 'base.html.twig' %}
{% block title %}Recettes — RecipeHub{% endblock %}

{% block body %}

<div class="hero-fullscreen">
    <div class="hero-overlay">
        <div class="hero-content text-center">
            <h1>Découvrez nos Recettes</h1>
            <p>Des recettes délicieuses pour tous les goûts</p>
            <a href="{{ path('recette_nouvelle') }}" class="btn-hero">+ Nouvelle recette</a>
            <div class="scroll-down mt-4">
                <i class="fas fa-chevron-down fa-2x" style="color:rgba(255,255,255,0.7);animation:bounce 2s infinite;"></i>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="section-title">Toutes les recettes</h2>
        <span class="text-muted">{{ recettes|length }} recette(s)</span>
    </div>

    <div class="row g-4">
        {% for recette in recettes %}
        <div class="col-xl-4 col-lg-4 col-md-6">
            <div class="recipe-card h-100">
                {% if recette.imageName %}
                    <img src="{{ asset('uploads/images/' ~ recette.imageName) }}"
                         class="card-img-top" alt="{{ recette.titre }}">
                {% else %}
                    <div class="card-img-placeholder">🍽️</div>
                {% endif %}

                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="fw-bold mb-0" style="color:#2c3e50">{{ recette.titre }}</h5>
                        {% if recette.difficulte == 'facile' %}
                            <span class="badge-facile">🟢 Facile</span>
                        {% elseif recette.difficulte == 'moyen' %}
                            <span class="badge-moyen">🟡 Moyen</span>
                        {% else %}
                            <span class="badge-difficile">🔴 Difficile</span>
                        {% endif %}
                    </div>

                    {% if recette.categorie %}
                        <p class="card-meta mb-1">
                            {{ recette.categorie.icone }} {{ recette.categorie.nom }}
                        </p>
                    {% endif %}

                    <p class="card-meta mb-2">
                        ⏱️ {{ recette.tempsPreparation + (recette.tempsCuisson ?? 0) }} min
                        &nbsp;|&nbsp; 👥 {{ recette.nbPersonnes }} pers.
                    </p>

                    <div class="mb-3">
                        {% for tag in recette.tags %}
                            <span class="badge rounded-pill me-1"
                                  style="background-color:{{ tag.couleur }};font-size:11px;">
                                {{ tag.nom }}
                            </span>
                        {% endfor %}
                    </div>

                    <div class="d-flex gap-2">
                        <a href="{{ path('recette_detail', {id: recette.id}) }}" class="btn-voir">
                            <i class="fas fa-eye me-1"></i>Voir
                        </a>
                        <a href="{{ path('recette_modifier', {id: recette.id}) }}" class="btn-modifier">
                            <i class="fas fa-edit me-1"></i>Modifier
                        </a>
                        <form method="post" action="{{ path('recette_supprimer', {id: recette.id}) }}"
                              onsubmit="return confirm('Supprimer ?')">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('supprimer' ~ recette.id) }}">
                            <button class="btn-suppr"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center py-5">
            <div style="font-size:80px">🍽️</div>
            <h4 class="mt-3 text-muted">Aucune recette</h4>
            <a href="{{ path('recette_nouvelle') }}" class="btn-hero mt-3 d-inline-block">
                Créer ma première recette
            </a>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}