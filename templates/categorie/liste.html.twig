{% extends 'base.html.twig' %}
{% block title %}Catégories{% endblock %}

{% block body %}
<div class="d-flex justify-content-between mb-4">
    <h1>📂 Catégories</h1>
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('categorie_nouvelle') }}" class="btn btn-success">+ Nouvelle</a>
    {% endif %}
</div>
<div class="row row-cols-1 row-cols-md-3 g-3">
{% for categorie in categories %}
    <div class="col">
        <div class="card h-100 text-center p-3">
            <div class="fs-1">{{ categorie.icone }}</div>
            <h5>{{ categorie.nom }}</h5>
            <p class="text-muted small">{{ categorie.description }}</p>
            <span class="badge bg-secondary">{{ categorie.recettes|length }} recette(s)</span>
        </div>
    </div>
{% else %}
    <div class="col-12"><div class="alert alert-info">Aucune catégorie.</div></div>
{% endfor %}
</div>
{% endblock %}